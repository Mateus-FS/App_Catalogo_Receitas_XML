<?xml version="1.0" encoding="utf-8"?>
<!-- Chip de categoria (Todas, Doces, Massas...). Sem android:id de propósito:
     o ChipGroup precisa de ids diferentes para cada chip. -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:fontFamily="sans-serif-medium"
    android:textColor="@color/selector_chip_text"
    android:textSize="14sp"
    app:checkedIconVisible="false"
    app:chipBackgroundColor="@color/selector_chip_background"
    app:chipCornerRadius="20dp"
    app:chipEndPadding="18dp"
    app:chipIconVisible="false"
    app:chipMinHeight="40dp"
    app:chipStartPadding="18dp"
    app:chipStrokeWidth="0dp"
    app:ensureMinTouchTargetSize="false"
    app:textEndPadding="0dp"
    app:textStartPadding="0dp" />