<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior (Receitas | Favoritos), usada com <include> nas 3 telas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Linha fina no topo da barra -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.Transparent.BottomNavigationIndicator"
        app:itemIconTint="@color/selector_nav_item"
        app:itemTextColor="@color/selector_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_barra_navegacao"
        app:paddingBottomSystemWindowInsets="true" />

</LinearLayout>