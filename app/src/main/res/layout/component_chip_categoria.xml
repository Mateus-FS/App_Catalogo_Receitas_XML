<?xml version="1.0" encoding="utf-8"?>
<!--
    ChipCategoria — equivalente XML do composable ChipCategoria.
    Use ChipCategoriaView (Kotlin) para controlar o estado selecionado.
    Ou use diretamente com.google.android.material.chip.Chip em um ChipGroup.
-->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    app:chipBackgroundColor="@color/selector_chip_background"
    app:chipCornerRadius="50dp"
    app:chipStrokeWidth="0dp"
    app:ensureMinTouchTargetSize="false"
    app:textColor="@color/selector_chip_text"
    app:chipIconVisible="false"
    app:checkedIconVisible="false"
    style="@style/Widget.Material3.Chip.Filter" />
