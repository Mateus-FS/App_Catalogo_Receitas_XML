<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 1: Lista de receitas (MainActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="2dp">

            <TextView
                style="@style/TextoCorpoMedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lista_subtitulo" />

            <TextView
                style="@style/TextoCabecalhoGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lista_titulo" />

            <!-- Campo de busca -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxBackgroundColor="@color/superficie"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_busca_borda"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/texto_secundario">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/busca_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Chips de categoria (criados pelo código) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="10dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Cards das receitas (o NestedScrollView é quem rola a tela inteira) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaReceitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Estado vazio -->
            <TextView
                android:id="@+id/mensagemVazia"
                style="@style/TextoCorpoMedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="@string/lista_vazia"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/barraNavegacao"
        layout="@layout/component_barra_navegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>