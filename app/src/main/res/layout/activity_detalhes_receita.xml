<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 2: Detalhes da receita -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Faixa colorida do topo (a cor vem da categoria) -->
            <FrameLayout
                android:id="@+id/cabecalho"
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <TextView
                    android:id="@+id/emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="88sp" />

                <!-- Botões de voltar e de favoritar -->
                <LinearLayout
                    android:id="@+id/botoesTopo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageButton
                        android:id="@+id/botaoVoltar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_botao_circular"
                        android:contentDescription="@string/cd_voltar"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="@color/texto_principal" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/botaoFavorito"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_botao_circular"
                        android:contentDescription="@string/cd_adicionar_favorito"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_favorite_border" />
                </LinearLayout>
            </FrameLayout>

            <!-- Conteúdo da receita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/categoria"
                    style="@style/TextoRotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/titulo"
                    style="@style/TextoTituloDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/resumo"
                    style="@style/TextoCorpoMedio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/descricao"
                    style="@style/TextoCorpoMedio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/TextoSecao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detalhes_ingredientes" />

                <!-- Linhas criadas pelo código -->
                <LinearLayout
                    android:id="@+id/listaIngredientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/TextoSecao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detalhes_preparo" />

                <LinearLayout
                    android:id="@+id/listaPassos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/barraNavegacao"
        layout="@layout/component_barra_navegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>