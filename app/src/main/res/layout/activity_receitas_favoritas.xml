<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 3: Receitas favoritas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="2dp">

            <TextView
                style="@style/TextoCorpoMedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favoritos_subtitulo" />

            <TextView
                style="@style/TextoCabecalhoGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favoritos_titulo" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaFavoritas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Estado vazio: coração + mensagem -->
            <LinearLayout
                android:id="@+id/estadoVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="78dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/texto_secundario" />

                <TextView
                    style="@style/TextoCorpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/favoritos_vazio"
                    android:textColor="@color/texto_secundario" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/barraNavegacao"
        layout="@layout/component_barra_navegacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>